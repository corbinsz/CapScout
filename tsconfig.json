{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/analytics.js",
    "src/monitoring.js",
    "src/utils/markets.js",
    "src/utils/scoreHelpers.js",
    "src/env.d.ts"
  ]
}
